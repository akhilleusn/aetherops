# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Docker Compose (used by docker-compose.yml) ---
POSTGRES_USER=aetherops_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aetherops
SERVER_PORT=8080

# --- Demo mode (optional) ---
# Set to true to create a public demo tenant on startup and enable GET /api/v1/demo/tenant.
# DEMO_MODE=true

# --- Real AI integration (optional) ---
# Set this to enable Claude (claude-sonnet-4-20250514) instead of the mock provider.
# Without it, the deterministic mock provider is used automatically.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Local development only (not used by Docker Compose) ---
# DB_URL=jdbc:postgresql://localhost:5432/aetherops
# DB_USERNAME=aetherops_user
# DB_PASSWORD=change_me
