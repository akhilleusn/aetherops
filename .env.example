# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Docker Compose (used by docker-compose.yml) ---
POSTGRES_USER=aetherops_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aetherops
SERVER_PORT=8080

# --- Required secrets (fail closed if unset — the app/container refuses to start without
# these; see STEP_REPORT.md, Phase 3 findings 1, 3 and 4) ---
# The values below are deliberately NOT valid secrets — copy-pasting this file unedited must
# fail loudly (the app refuses to start) rather than silently run with a secret every clone of
# this repo shares. Generate your own for every value below.
APP_JWT_SECRET=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET_AT_LEAST_32_CHARS

# AES-256 keys for encrypted-at-rest tokens, one per purpose. Each must be EXACTLY 32
# characters. Generate one with: openssl rand -hex 16   (16 bytes = 32 hex characters)
APP_SLACK_TOKEN_ENCRYPTION_KEYS_1=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_16
APP_CALENDAR_TOKEN_ENCRYPTION_KEYS_1=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_16
APP_INTEGRATIONS_TOKEN_ENCRYPTION_KEYS_1=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_16
APP_TOTP_ENCRYPTION_KEYS_1=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_16

# HMAC secrets for this app's own OAuth "state" CSRF tokens — each is its own dedicated key,
# not shared with any Slack- or Google-provided secret. No length requirement, but treat them
# like any other secret (long, random, unique per environment).
APP_SLACK_OAUTH_STATE_SECRET=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET
APP_CALENDAR_OAUTH_STATE_SECRET=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET

# --- Demo mode (optional) ---
# Set to true to create a public demo tenant on startup and enable GET /api/v1/demo/tenant.
# DEMO_MODE=true

# --- Real AI integration (optional) ---
# Set this to enable Claude (claude-sonnet-4-20250514) instead of the mock provider.
# Without it, the deterministic mock provider is used automatically.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Local development only (running the app directly, e.g. `mvn spring-boot:run`,
# instead of through Docker Compose — these are the actual Spring property names,
# not DB_URL/DB_USERNAME/DB_PASSWORD, which the app never reads) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aetherops
# SPRING_DATASOURCE_USERNAME=aetherops_user
# SPRING_DATASOURCE_PASSWORD=change_me
